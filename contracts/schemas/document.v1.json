{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appname.org/spec/document.v1.json",
  "title": "appname.document.v1",
  "type": "object",
  "required": [
    "schema",
    "geometry",
    "color",
    "root",
    "layers"
  ],
  "properties": {
    "schema": {
      "const": "appname.document.v1"
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    },
    "color": {
      "$ref": "#/$defs/colorState"
    },
    "root": {
      "type": "string",
      "format": "uuid"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "ops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "masks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mask"
      }
    },
    "channels": {
      "$ref": "#/$defs/channelSet"
    },
    "guides": {
      "$ref": "#/$defs/guides"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "required": [
        "imageSize",
        "canvasSize",
        "resolutionPPI"
      ],
      "properties": {
        "imageSize": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "canvasSize": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "resolutionPPI": {
          "type": "number"
        },
        "artboards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artboard"
          }
        },
        "cropRect": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x,y,w,h] document px (§19.1) — the NON-DESTRUCTIVE crop window. ABSENT when no crop is active; a cropped package emits it. When present, imageSize MUST equal [w,h] (§19.2). Canvas ops that reset the frame clear it."
        }
      }
    },
    "colorState": {
      "type": "object",
      "required": [
        "working",
        "mode",
        "depth"
      ],
      "properties": {
        "working": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "enum": [
            "gray",
            "grayA",
            "rgb",
            "rgba",
            "cmyk",
            "cmykA",
            "lab",
            "labA"
          ]
        },
        "depth": {
          "enum": [
            "u8",
            "u16",
            "f16",
            "f32"
          ]
        },
        "renderingIntent": {
          "enum": [
            "perceptual",
            "relativeColorimetric",
            "saturation",
            "absoluteColorimetric"
          ]
        },
        "blackPointCompensation": {
          "type": "boolean"
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "blend",
        "opacity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "raster",
            "group",
            "adjustment",
            "fill",
            "text",
            "shape",
            "smartObject"
          ]
        },
        "blend": {
          "enum": [
            "normal",
            "dissolve",
            "darken",
            "multiply",
            "colorBurn",
            "linearBurn",
            "darkerColor",
            "lighten",
            "screen",
            "colorDodge",
            "linearDodge",
            "lighterColor",
            "overlay",
            "softLight",
            "hardLight",
            "vividLight",
            "linearLight",
            "pinLight",
            "hardMix",
            "difference",
            "exclusion",
            "subtract",
            "divide",
            "hue",
            "saturation",
            "color",
            "luminosity"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible": {
          "type": "boolean"
        },
        "clipToBelow": {
          "type": "boolean"
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 9,
          "maxItems": 9
        },
        "masks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tilesRef": {
          "type": "string",
          "description": "layers/{id}/tiles for raster"
        },
        "isolated": {
          "type": "boolean",
          "description": "groups only; false = pass-through (§4.7)"
        },
        "opRef": {
          "type": "string",
          "format": "uuid",
          "description": "adjustment layers: ops/{opId}.json (§7.5)"
        },
        "fill": {
          "$ref": "#/$defs/fill",
          "description": "fill layers (§22)"
        },
        "textRef": {
          "type": "string",
          "description": "text layers: text/{layerId}.json (§7.5)"
        },
        "pathRef": {
          "type": "string",
          "format": "uuid",
          "description": "shape layers: vector/{pathId}.json (§20.2)"
        },
        "stroke": {
          "type": "object",
          "additionalProperties": true,
          "description": "shape stroke params (§20.2)"
        },
        "smartObject": {
          "$ref": "#/$defs/smartObject"
        },
        "locks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "transparency",
              "position",
              "pixels",
              "all"
            ]
          }
        },
        "colorLabel": {
          "enum": [
            "red",
            "orange",
            "yellow",
            "green",
            "blue",
            "violet",
            "gray"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "raster"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "tilesRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "adjustment"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "opRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "fill"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "textRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "shape"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "pathRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "smartObject"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "smartObject"
            ]
          }
        }
      ]
    },
    "mask": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "raster",
            "vector",
            "clip"
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "inverted": {
          "type": "boolean",
          "default": false
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "feather": {
          "type": "number",
          "minimum": 0,
          "description": "px, applied live (§11.2)"
        },
        "linked": {
          "type": "boolean",
          "default": true,
          "description": "moves with layer transform"
        },
        "tilesRef": {
          "type": "string",
          "description": "layers/{layerId}/masks/{maskId}/tiles"
        },
        "pathRef": {
          "type": "string",
          "format": "uuid",
          "description": "vector/{pathId}.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "raster"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "tilesRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "vector"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "pathRef"
            ]
          }
        }
      ]
    },
    "color": {
      "type": "object",
      "required": [
        "model",
        "comps"
      ],
      "properties": {
        "model": {
          "enum": [
            "gray",
            "grayA",
            "rgb",
            "rgba",
            "cmyk",
            "cmykA",
            "lab",
            "labA"
          ]
        },
        "comps": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "profileId": {
          "type": "string",
          "format": "uuid",
          "description": "omitted = document working profile (§5.1, §22.1)"
        }
      }
    },
    "gradient": {
      "type": "object",
      "required": [
        "stops",
        "kind"
      ],
      "properties": {
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "pos",
              "color"
            ],
            "properties": {
              "pos": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "color": {
                "$ref": "#/$defs/color"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              },
              "midpoint": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.5
              }
            }
          }
        },
        "kind": {
          "enum": [
            "linear",
            "radial",
            "angular",
            "reflected",
            "diamond",
            "noise"
          ]
        },
        "space": {
          "enum": [
            "linearRgb",
            "perceptual"
          ],
          "default": "linearRgb"
        },
        "dither": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "fill": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "color"
          ],
          "properties": {
            "type": {
              "const": "solid"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "gradient"
          ],
          "properties": {
            "type": {
              "const": "gradient"
            },
            "gradient": {
              "$ref": "#/$defs/gradient"
            },
            "angleDeg": {
              "type": "number",
              "default": 90
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "reverse": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "patternRef"
          ],
          "properties": {
            "type": {
              "const": "pattern"
            },
            "patternRef": {
              "type": "string",
              "description": "assets/{assetHash} (§7.5, §22.5)"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "phase": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        }
      ]
    },
    "blendMode": {
      "enum": [
        "normal",
        "dissolve",
        "darken",
        "multiply",
        "colorBurn",
        "linearBurn",
        "darkerColor",
        "lighten",
        "screen",
        "colorDodge",
        "linearDodge",
        "lighterColor",
        "overlay",
        "softLight",
        "hardLight",
        "vividLight",
        "linearLight",
        "pinLight",
        "hardMix",
        "difference",
        "exclusion",
        "subtract",
        "divide",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ],
      "description": "same 27 values and order as §4.5 repr(u32) 0..=26"
    },
    "effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/fxDropShadow"
        },
        {
          "$ref": "#/$defs/fxInnerShadow"
        },
        {
          "$ref": "#/$defs/fxOuterGlow"
        },
        {
          "$ref": "#/$defs/fxInnerGlow"
        },
        {
          "$ref": "#/$defs/fxStroke"
        },
        {
          "$ref": "#/$defs/fxColorOverlay"
        },
        {
          "$ref": "#/$defs/fxGradientOverlay"
        },
        {
          "$ref": "#/$defs/fxPatternOverlay"
        },
        {
          "$ref": "#/$defs/fxBevel"
        },
        {
          "$ref": "#/$defs/fxSatin"
        }
      ]
    },
    "fxDropShadow": {
      "type": "object",
      "required": [
        "type",
        "color",
        "opacity",
        "distancePx",
        "sizePx"
      ],
      "properties": {
        "type": {
          "const": "dropShadow"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "blend": {
          "$ref": "#/$defs/blendMode",
          "default": "multiply"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35
        },
        "angleDeg": {
          "type": "number",
          "default": 120,
          "minimum": -180,
          "maximum": 180
        },
        "useGlobalLight": {
          "type": "boolean",
          "default": true
        },
        "distancePx": {
          "type": "number",
          "minimum": 0,
          "maximum": 30000
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "sizePx": {
          "type": "number",
          "minimum": 0,
          "maximum": 250
        }
      }
    },
    "fxInnerShadow": {
      "type": "object",
      "required": [
        "type",
        "color",
        "opacity",
        "distancePx",
        "sizePx"
      ],
      "properties": {
        "type": {
          "const": "innerShadow"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "blend": {
          "$ref": "#/$defs/blendMode",
          "default": "multiply"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35
        },
        "angleDeg": {
          "type": "number",
          "default": 120,
          "minimum": -180,
          "maximum": 180
        },
        "useGlobalLight": {
          "type": "boolean",
          "default": true
        },
        "distancePx": {
          "type": "number",
          "minimum": 0,
          "maximum": 30000
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "sizePx": {
          "type": "number",
          "minimum": 0,
          "maximum": 250
        }
      }
    },
    "fxOuterGlow": {
      "type": "object",
      "required": [
        "type",
        "opacity",
        "sizePx"
      ],
      "properties": {
        "type": {
          "const": "outerGlow"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "blend": {
          "$ref": "#/$defs/blendMode",
          "default": "screen"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35
        },
        "technique": {
          "enum": [
            "softer",
            "precise"
          ],
          "default": "softer"
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "sizePx": {
          "type": "number",
          "minimum": 0,
          "maximum": 250
        },
        "range": {
          "type": "number",
          "maximum": 1,
          "default": 0.5,
          "minimum": 0.01
        }
      },
      "oneOf": [
        {
          "required": [
            "color"
          ]
        },
        {
          "required": [
            "gradient"
          ]
        }
      ]
    },
    "fxInnerGlow": {
      "type": "object",
      "required": [
        "type",
        "opacity",
        "sizePx"
      ],
      "properties": {
        "type": {
          "const": "innerGlow"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "blend": {
          "$ref": "#/$defs/blendMode",
          "default": "screen"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35
        },
        "technique": {
          "enum": [
            "softer",
            "precise"
          ],
          "default": "softer"
        },
        "source": {
          "enum": [
            "center",
            "edge"
          ],
          "default": "edge"
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "sizePx": {
          "type": "number",
          "minimum": 0,
          "maximum": 250
        },
        "range": {
          "type": "number",
          "maximum": 1,
          "default": 0.5,
          "minimum": 0.01
        }
      },
      "oneOf": [
        {
          "required": [
            "color"
          ]
        },
        {
          "required": [
            "gradient"
          ]
        }
      ]
    },
    "fxStroke": {
      "type": "object",
      "required": [
        "type",
        "sizePx",
        "position",
        "fill"
      ],
      "properties": {
        "type": {
          "const": "stroke"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "sizePx": {
          "type": "number",
          "minimum": 1,
          "maximum": 250
        },
        "position": {
          "enum": [
            "inside",
            "center",
            "outside"
          ],
          "default": "outside"
        },
        "blend": {
          "$ref": "#/$defs/blendMode",
          "default": "normal"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "fill": {
          "$ref": "#/$defs/fill"
        }
      }
    },
    "fxColorOverlay": {
      "type": "object",
      "required": [
        "type",
        "color"
      ],
      "properties": {
        "type": {
          "const": "colorOverlay"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "blend": {
          "$ref": "#/$defs/blendMode",
          "default": "normal"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      }
    },
    "fxGradientOverlay": {
      "type": "object",
      "required": [
        "type",
        "gradient"
      ],
      "properties": {
        "type": {
          "const": "gradientOverlay"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "blend": {
          "$ref": "#/$defs/blendMode",
          "default": "normal"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "angleDeg": {
          "type": "number",
          "default": 90,
          "minimum": -180,
          "maximum": 180
        },
        "scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 1.5
        },
        "alignWithLayer": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "fxPatternOverlay": {
      "type": "object",
      "required": [
        "type",
        "patternRef"
      ],
      "properties": {
        "type": {
          "const": "patternOverlay"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "patternRef": {
          "type": "string",
