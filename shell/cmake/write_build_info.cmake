#
# Capture the BUILD's own commit, freshly, every build.
#
# WHY NOT A CONFIGURE-TIME CAPTURE (measured C-724 before choosing). The
# usual idiom anchors freshness on `${SOURCE_DIR}/.git/HEAD` and it is
# doubly wrong here:
#   * this is a git WORKTREE, so `.git` is a FILE, not a directory; and
#   * `HEAD` names the branch and moves only on a branch SWITCH — the file
#     that changes on a COMMIT is the ref under the COMMON git dir, which
#     `git gc` can pack out of existence entirely.
# Both failure modes yield a SILENTLY STALE sha. A stale commit in an About
# box is the same confident falsehood this desk refused to ship for the
# version (C-708), so freshness is not anchored on a file at all: this runs
# every build, and only REWRITES the header when the value actually changes,
# so a recompile happens exactly when the truth does.
#
# `--dirty` IS LOAD-BEARING, NOT DECORATION. A sha alone says "these bytes"
# while an uncommitted tree means "these bytes plus something unrecorded".
# A build from a modified tree that reports a clean sha is a lie of exactly
# the kind an About box must not tell.

if(NOT DEFINED SRC OR NOT DEFINED OUT)
  message(FATAL_ERROR "write_build_info.cmake: SRC and OUT are required")
endif()

set(_sha "unknown")
find_program(_git git)
if(_git)
  execute_process(
    COMMAND "${_git}" -C "${SRC}" rev-parse --short HEAD
    OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0 OR _sha STREQUAL "")
    set(_sha "unknown")   # not a repo, or git refused — SAY so, never guess
  else()
    # `--untracked-files=no` IS REQUIRED, NOT AN OPTIMISATION. Measured
    # live: with a plain `status --porcelain` this reported `-dirty` on a
    # tree with ZERO tracked modifications, because `.claude/
    # settings.local.json` is UNTRACKED BY RULING and never goes away. A
    # marker that is constant distinguishes nothing — and it was constant
    # in the LYING direction, telling a user their clean build was modified.
    # Dirtiness here means "tracked files differ from HEAD", which is the
    # standard meaning and the only one that can vary in this repo.
    #
    # STATED LIMIT: an untracked file inside a GLOBBED input directory
    # (i18n/*.json is the one such glob) would be built and would NOT be
    # flagged. That is a real gap, narrower than the false-positive it
    # replaces, and it is written here rather than discovered later.
    execute_process(
      COMMAND "${_git}" -C "${SRC}" status --porcelain --untracked-files=no
      OUTPUT_VARIABLE _dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT _dirty STREQUAL "")
      set(_sha "${_sha}-dirty")
    endif()
  endif()
endif()

set(_content "// GENERATED by shell/cmake/write_build_info.cmake — do not edit.\n#pragma once\n#define APPNAME_BUILD_COMMIT \"${_sha}\"\n")
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _content)
  file(WRITE "${OUT}" "${_content}")
endif()
